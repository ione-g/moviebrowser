CREATE TABLE favorite_movie (
  id INTEGER NOT NULL PRIMARY KEY,
  title TEXT NOT NULL,
  overview TEXT NOT NULL,
  posterPath TEXT,
  releaseDate TEXT,
  addedAt INTEGER NOT NULL
);

selectAll:
SELECT * FROM favorite_movie ORDER BY addedAt DESC;

selectIds:
SELECT id FROM favorite_movie;

selectById:
SELECT * FROM favorite_movie WHERE id = ?;

insertMovie:
INSERT OR REPLACE INTO favorite_movie(id, title, overview, posterPath, releaseDate, addedAt)
VALUES (?, ?, ?, ?, ?, ?);

deleteById:
DELETE FROM favorite_movie WHERE id = ?;
